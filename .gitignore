# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.venv/
.env
.env.*
!.env.example
catboost_info/

# iOS local configuration
**/Local.xcconfig
!**/Local.xcconfig.example

# Local Windows demo launcher build output
/build/
/dist/
/*.spec

# Local source data (large and redistributed separately)
data/raw/**
!data/raw/README.md
!data/raw/**/
!data/raw/**/README.md
data/external/**
!data/external/README.md
!data/external/**/
!data/external/**/README.md

# Reproducible generated artifacts
data/interim/**
!data/interim/README.md
!data/interim/**/
!data/interim/**/README.md
data/processed/**
!data/processed/README.md
!data/processed/**/
!data/processed/**/README.md

# Large/reference data may be supplied externally; keep documentation and small fixtures only.
data/reference/**
!data/reference/README.md
!data/reference/**/
!data/reference/**/README.md

# Local logs and editor files
*.log
.idea/
.vscode/
~$*
