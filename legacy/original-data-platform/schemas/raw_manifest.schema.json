{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy-data-platform.local/schemas/raw_manifest.schema.json",
  "title": "Canopy raw data manifest",
  "description": "Manifest for immutable source files used by a pipeline run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "download_date",
    "generated_at_utc",
    "files"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "download_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "size_bytes",
          "sha256",
          "observed_mtime_utc"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_mtime_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
