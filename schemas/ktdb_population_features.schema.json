{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy-data-platform.local/schemas/ktdb_population_features.schema.json",
  "title": "KTDB population model feature row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trip_id",
    "person_group_id",
    "actual_mode_sequence",
    "main_mode_raw_code",
    "survey_date",
    "weekday",
    "departure_hour",
    "departure_minute_bin",
    "time_band",
    "origin_admin_dong",
    "origin_sido",
    "origin_sigungu",
    "destination_admin_dong",
    "destination_sido",
    "destination_sigungu",
    "od_scope",
    "od_straight_distance_km",
    "distance_band",
    "purpose",
    "commute_direction",
    "actual_mode",
    "split"
  ],
  "properties": {
    "trip_id": {"type": "string"},
    "person_group_id": {"type": "string"},
    "actual_mode_sequence": {"type": "string"},
    "main_mode_raw_code": {"type": ["string", "null"]},
    "survey_date": {"type": "string", "pattern": "^2021-[0-9]{2}-[0-9]{2}$"},
    "weekday": {"type": "string"},
    "departure_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "departure_minute_bin": {"type": "integer", "minimum": 0, "maximum": 45},
    "time_band": {"type": "string"},
    "origin_admin_dong": {"type": "string"},
    "origin_sido": {"type": "string"},
    "origin_sigungu": {"type": "string"},
    "destination_admin_dong": {"type": "string"},
    "destination_sido": {"type": "string"},
    "destination_sigungu": {"type": "string"},
    "od_scope": {"type": "string"},
    "od_straight_distance_km": {"type": ["number", "null"], "minimum": 0},
    "distance_band": {"type": ["string", "null"]},
    "purpose": {"type": "string"},
    "commute_direction": {"type": "string"},
    "actual_mode": {"enum": ["walk", "bike", "car", "bus", "rail"]},
    "split": {"enum": ["train", "validation", "test"]}
  }
}
